<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Sandbox is OFF: synthesizing Cmd-V (direct paste) and reading the
	  frontmost app are not possible in a sandboxed app. This matches Maccy's
	  non-App-Store build and Pastebot's helper approach. Distribute outside
	  the Mac App Store, or ship a sandboxed variant with pasteDirectly off.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
